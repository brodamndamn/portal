[Unit]
Description=ResearchFlow 深度研究 FastAPI 服务
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/resume-projects/agents_project/backend
EnvironmentFile=/opt/resume-projects/agents_project/backend/.env
Environment=RESEARCHFLOW_ENVIRONMENT=production
ExecStart=/opt/resume-projects/agents_project/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8001 --workers 1
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/resume-projects/agents_project/backend/data

[Install]
WantedBy=multi-user.target
